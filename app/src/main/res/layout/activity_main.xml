<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#0F1016">

    <!-- الحاوية الرئيسية للشاشات الثلاث -->
    <FrameLayout
        android:id="@+id/contentFrame"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- ======================= 1. واجهة البث والريموت ======================= -->
        <ScrollView
            android:id="@+id/tabHome"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp"
                android:gravity="center_horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="AboEzzat Share"
                    android:textColor="#E0E6ED"
                    android:textSize="24sp"
                    android:textStyle="bold"
                    android:layout_marginTop="10dp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/tvConnectedIpDisplay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="متصل بالشاشة: 10.229.144.16:1997"
                    android:textColor="#38EF7D"
                    android:textSize="13sp"
                    android:layout_marginBottom="24dp" />

                <!-- بطاقة إرسال الوسائط -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="20dp">

                    <Button
                        android:id="@+id/btnPickVideo"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="🎬  إرسال فيديو من الهاتف"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:background="#1F2430"
                        android:layout_marginBottom="12dp" />

                    <Button
                        android:id="@+id/btnPickImage"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="🖼️  إرسال صورة من الهاتف"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:background="#1F2430"
                        android:layout_marginBottom="12dp" />

                    <Button
                        android:id="@+id/btnPickAudio"
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:text="🎵  إرسال مقطع صوتي"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:background="#1F2430" />
                </LinearLayout>

                <!-- ريموت كنترول الشاشة -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="التحكم السريع في العرض"
                    android:textColor="#8F9CAE"
                    android:textSize="14sp"
                    android:layout_marginBottom="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="12dp">

                    <Button
                        android:id="@+id/btnRewind"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:text="⏪ 10ث"
                        android:textColor="#FFFFFF"
                        android:background="#181C26"
                        android:layout_marginRight="8dp" />

                    <Button
                        android:id="@+id/btnPlayPause"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1.2"
                        android:text="⏯ تشغيل/إيقاف"
                        android:textColor="#111111"
                        android:textStyle="bold"
                        android:background="#38EF7D"
                        android:layout_marginRight="8dp" />

                    <Button
                        android:id="@+id/btnForward"
                        android:layout_width="0dp"
                        android:layout_height="52dp"
                        android:layout_weight="1"
                        android:text="10ث ⏩"
                        android:textColor="#FFFFFF"
                        android:background="#181C26" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnStop"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="⏹ إنهاء العرض والعودة للواجهة"
                    android:textColor="#FF5252"
                    android:background="#24141E" />

            </LinearLayout>
        </ScrollView>

        <!-- ======================= 2. واجهة المتصفح ======================= -->
        <LinearLayout
            android:id="@+id/tabBrowser"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:visibility="gone">

            <!-- شريط علوي للتحكم في المتصفح والرجوع للرئيسية -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="54dp"
                android:orientation="horizontal"
                android:background="#161922"
                android:gravity="center_vertical"
                android:paddingLeft="10dp"
                android:paddingRight="10dp">

                <Button
                    android:id="@+id/btnBrowserHome"
                    android:layout_width="48dp"
                    android:layout_height="40dp"
                    android:text="🏠"
                    android:textSize="18sp"
                    android:textColor="#38EF7D"
                    android:background="#222836" />

                <EditText
                    android:id="@+id/etBrowserUrl"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:background="#0F1118"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:paddingLeft="12dp"
                    android:paddingRight="12dp"
                    android:hint="أدخل الرابط أو ابحث..."
                    android:textColorHint="#5E687A"
                    android:inputType="textUri"
                    android:imeOptions="actionGo"
                    android:layout_marginLeft="8dp"
                    android:layout_marginRight="8dp" />

                <Button
                    android:id="@+id/btnBrowserGo"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="ذهاب"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:background="#2A3142" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/browserProgress"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:visibility="gone" />

            <WebView
                android:id="@+id/mainWebView"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </LinearLayout>

        <!-- ======================= 3. واجهة الإعدادات والـ IP ======================= -->
        <ScrollView
            android:id="@+id/tabSettings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="إعدادات شاشة الاستقبال"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="حدد عنوان الآي بي المعروض على شاشة الفاير ستيك"
                    android:textColor="#7A8799"
                    android:textSize="13sp"
                    android:layout_marginBottom="24dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="عنوان IP الشاشة:"
                    android:textColor="#C0C9D6"
                    android:textSize="14sp"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/etTvIpSettings"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="#161922"
                    android:textColor="#38EF7D"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:hint="مثال: 10.229.144.16"
                    android:textColorHint="#4B5466"
                    android:inputType="phone"
                    android:imeOptions="actionDone"
                    android:layout_marginBottom="16dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="منفذ الاتصال (Port):"
                    android:textColor="#C0C9D6"
                    android:textSize="14sp"
                    android:layout_marginBottom="6dp" />

                <EditText
                    android:id="@+id/etTvPortSettings"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="#161922"
                    android:textColor="#38EF7D"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:paddingLeft="14dp"
                    android:paddingRight="14dp"
                    android:text="1997"
                    android:inputType="number"
                    android:layout_marginBottom="24dp" />

                <Button
                    android:id="@+id/btnSaveSettings"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="💾  حفظ وتطبيق الإعدادات"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:background="#2979FF" />

            </LinearLayout>
        </ScrollView>

    </FrameLayout>

    <!-- شريط القوائم السفلي الحديث -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:orientation="horizontal"
        android:background="#12141C"
        android:gravity="center">

        <LinearLayout
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📡"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/txtNavHome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="البث"
                android:textColor="#38EF7D"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navBrowser"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌐"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/txtNavBrowser"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="المتصفح"
                android:textColor="#667085"
                android:textSize="12sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/navSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚙️"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/txtNavSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="الإعدادات"
                android:textColor="#667085"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
