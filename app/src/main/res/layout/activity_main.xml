<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- الواجهة القديمة الأصلية بدون أي تعديل أو حذف -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#101014"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- الهيدر مع زرار القائمة الجانبية المضاف -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="20dp">

                <Button
                    android:id="@+id/btn_open_drawer"
                    android:layout_width="45dp"
                    android:layout_height="45dp"
                    android:text="☰"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:background="#262833"
                    android:layout_marginEnd="10dp" />

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Abo Ezzat Cast"
                    android:textColor="#FFFFFF"
                    android:textSize="22sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tv_status_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🔍 فحص الشاشة تلقائياً"
                    android:textColor="#00E676"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:background="#1B2E23"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp" />
            </LinearLayout>

            <!-- كارت إعدادات الاتصال بالشاشة القديم -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#1B1C23"
                android:padding="16dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📡 الاتصال بجهاز الاستقبال (TV Receiver)"
                    android:textColor="#00B0FF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="10dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/et_ip"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="عنوان IP الشاشة (مثال: 192.168.1.15)"
                        android:textColor="#FFFFFF"
                        android:textColorHint="#616161"
                        android:background="#262833"
                        android:padding="12dp"
                        android:textSize="14sp"
                        android:inputType="textUri" />

                    <Button
                        android:id="@+id/btn_save"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="حفظ"
                        android:textColor="#000000"
                        android:backgroundTint="#FFD700"
                        android:layout_marginStart="8dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- كروت المهام الرئيسية القديمة -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="أدوات ومصادر البث"
                android:textColor="#9E9E9E"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp" />

            <!-- كارت المتصفح الذكي القديم -->
            <LinearLayout
                android:id="@+id/card_browser"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="#1E2330"
                android:padding="16dp"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌐"
                    android:textSize="28sp"
                    android:layout_marginEnd="14dp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="المتصفح وقانص الوسائط"
                        android:textColor="#FFFFFF"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="تصفح مواقع الفيديو، إنستجرام، فيسبوك وبث فوري"
                        android:textColor="#88A0B8"
                        android:textSize="12sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- صف كروت ثنائي القديم -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <!-- وسائط الهاتف -->
                <LinearLayout
                    android:id="@+id/card_local_media"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="#251E28"
                    android:padding="16dp"
                    android:layout_marginEnd="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎬"
                        android:textSize="26sp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="وسائط الهاتف"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="بث فيديو، صورة أو صوت منفرد"
                        android:textColor="#B090B8"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>

                <!-- سلايد شو المجلدات -->
                <LinearLayout
                    android:id="@+id/card_slideshow"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:background="#1E2822"
                    android:padding="16dp"
                    android:layout_marginStart="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🖼️"
                        android:textSize="26sp"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="معرض متتابع"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="عرض ألبوم صور وراء بعض"
                        android:textColor="#88B89E"
                        android:textSize="11sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- لوحة التحكم الكاملة القديمة (الريموت المحدث) -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="التحكم بالشاشة (Quick Remote)"
                android:textColor="#9E9E9E"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginTop="10dp"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#1B1C23"
                android:padding="12dp">

                <!-- صف التالي والتشغيل والسابق -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp"
                    android:gravity="center">

                    <Button
                        android:id="@+id/btn_next"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="التالي ⏭️"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#2D303E"
                        android:layout_marginEnd="3dp" />

                    <Button
                        android:id="@+id/btn_play_pause"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.2"
                        android:text="⏯️ تشغيل"
                        android:textColor="#000000"
                        android:backgroundTint="#00B0FF"
                        android:layout_marginHorizontal="3dp" />

                    <Button
                        android:id="@+id/btn_prev"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="⏮️ السابق"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#2D303E"
                        android:layout_marginStart="3dp" />
                </LinearLayout>

                <!-- صف التقديم والتأخير -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="8dp"
                    android:gravity="center">

                    <Button
                        android:id="@+id/btn_forward"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="10s تقديم ⏩"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#262833"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/btn_rewind"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="⏪ 10s تأخير"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#262833"
                        android:layout_marginStart="4dp" />
                </LinearLayout>

                <!-- صف الصوت -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center">

                    <Button
                        android:id="@+id/btn_vol_up"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🔊 تعلية"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#262833"
                        android:layout_marginEnd="4dp" />

                    <Button
                        android:id="@+id/btn_mute"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🔇 كتم"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#D32F2F"
                        android:layout_marginHorizontal="4dp" />

                    <Button
                        android:id="@+id/btn_vol_down"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🔉 تقليل"
                        android:textColor="#FFFFFF"
                        android:backgroundTint="#262833"
                        android:layout_marginStart="4dp" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
    <!-- القائمة الجانبية المنسحبة بنفس ترتيب وأدوات صورتك تماماً -->
    <ScrollView
        android:id="@+id/nav_view"
        android:layout_width="290dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="#1E1E24"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- عنوان رأس القائمة -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Abo Ezzat Cast"
                android:textColor="#00B0FF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:gravity="start"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="20dp" />

            <!-- 1. المتصفح -->
            <LinearLayout
                android:id="@+id/menu_browser"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:layout_width="35dp"
                    android:layout_height="wrap_content"
                    android:text="🌐"
                    android:textSize="18sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="المتصفح"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 2. ملفات الهاتف -->
            <LinearLayout
                android:id="@+id/menu_local_media"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:layout_width="35dp"
                    android:layout_height="wrap_content"
                    android:text="📁"
                    android:textSize="18sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ملفات الهاتف"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- 3. IPTV -->
            <LinearLayout
                android:id="@+id/menu_iptv"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:layout_width="35dp"
                    android:layout_height="wrap_content"
                    android:text="📺"
                    android:textSize="18sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="IPTV"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- 4. الوسائط الأخيرة -->
            <LinearLayout
                android:id="@+id/menu_recent_media"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:layout_width="35dp"
                    android:layout_height="wrap_content"
                    android:text="⏯️"
                    android:textSize="18sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="الوسائط الأخيرة"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- 5. قائمة التشغيل -->
            <LinearLayout
                android:id="@+id/menu_playlist"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:layout_width="35dp"
                    android:layout_height="wrap_content"
                    android:text="📑"
                    android:textSize="18sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="قائمة التشغيل"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- 6. العلامات المرجعية -->
            <LinearLayout
                android:id="@+id/menu_bookmarks"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:layout_width="35dp"
                    android:layout_height="wrap_content"
                    android:text="🔖"
                    android:textSize="18sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="العلامات المرجعية"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- 7. سجل المتصفح -->
            <LinearLayout
                android:id="@+id/menu_history"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:layout_width="35dp"
                    android:layout_height="wrap_content"
                    android:text="🕒"
                    android:textSize="18sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="سجل المتصفح"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- 8. الأكثر زيارة -->
            <LinearLayout
                android:id="@+id/menu_most_visited"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:layout_width="35dp"
                    android:layout_height="wrap_content"
                    android:text="⭐"
                    android:textSize="18sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="الأكثر زيارة"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- 9. التنزيلات -->
            <LinearLayout
                android:id="@+id/menu_downloads"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:layout_width="35dp"
                    android:layout_height="wrap_content"
                    android:text="📥"
                    android:textSize="18sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="التنزيلات"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- خط فاصل -->
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#2E303D"
                android:layout_marginVertical="12dp" />

            <!-- 10. الوضع المظلم -->
            <LinearLayout
                android:id="@+id/menu_dark_mode"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:layout_width="35dp"
                    android:layout_height="wrap_content"
                    android:text="🌙"
                    android:textSize="18sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="الوضع المظلم"
                    android:textColor="#B0B0B0"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 11. النسخ الاحتياطي / استعادة -->
            <LinearLayout
                android:id="@+id/menu_backup"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:layout_width="35dp"
                    android:layout_height="wrap_content"
                    android:text="🔄"
                    android:textSize="18sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="النسخ الاحتياطي / استعادة"
                    android:textColor="#B0B0B0"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 12. إعدادات -->
            <LinearLayout
                android:id="@+id/menu_settings"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:layout_width="35dp"
                    android:layout_height="wrap_content"
                    android:text="⚙️"
                    android:textSize="18sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="إعدادات"
                    android:textColor="#B0B0B0"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- 13. خروج -->
            <LinearLayout
                android:id="@+id/menu_exit"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true">
                <TextView
                    android:layout_width="35dp"
                    android:layout_height="wrap_content"
                    android:text="🚪"
                    android:textSize="18sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="خروج"
                    android:textColor="#FF5252"
                    android:textSize="14sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</androidx.drawerlayout.widget.DrawerLayout>
